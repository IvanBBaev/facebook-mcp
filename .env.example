# facebook-mcp — environment template.
#
# GENERATED FILE — edit scripts/metadata.config.mjs and run `npm run metadata`.
#
# Copy to `.env` (git-ignored) or export these in your MCP client config.
# Real environment variables always win over the env file.
# Every variable is optional except where noted; leave a line commented out
# to take the documented default.

# ---------------------------------------------------------------------------
# Credentials — provide at least one token
# ---------------------------------------------------------------------------

# System-user access token (Business Manager). Takes precedence over
# FB_ACCESS_TOKEN and FB_PAGE_TOKEN when several are set.
# (required: at least one token; secret — never logged or returned by a tool)
#FB_SYSTEM_TOKEN=

# Primary user access token. At least one of FB_SYSTEM_TOKEN, FB_ACCESS_TOKEN
# or FB_PAGE_TOKEN must be set.
# (required: at least one token; secret — never logged or returned by a tool)
#FB_ACCESS_TOKEN=

# Long-lived Page access token used as a fallback credential when no user or
# system-user token is configured.
# (required: at least one token; secret — never logged or returned by a tool)
#FB_PAGE_TOKEN=

# ---------------------------------------------------------------------------
# Meta app
# ---------------------------------------------------------------------------

# Meta app ID; combined with FB_APP_SECRET it forms the app access token used
# to authorize /debug_token inspection.
#FB_APP_ID=

# Meta app secret. When set, appsecret_proof is attached to every call so a
# stolen bare token cannot be used on its own.
# (secret — never logged or returned by a tool)
#FB_APP_SECRET=

# ---------------------------------------------------------------------------
# Page topology
# ---------------------------------------------------------------------------

# Default Facebook Page ID, used when a tool call omits an explicit profile
# argument.
#FB_PAGE_ID=

# ---------------------------------------------------------------------------
# Graph API wire
# ---------------------------------------------------------------------------

# Graph API version to target. Defaults to the tested pinned version; other
# values are accepted verbatim as an escape hatch but are not tested.
# (default: v23.0)
#FB_API_VERSION=v23.0

# Per-request timeout in milliseconds; integer in [1, 600000].
# (default: 60000)
#FB_REQUEST_TIMEOUT_MS=60000

# Maximum number of in-flight requests per Graph host; integer in [1, 64].
# (default: 4)
#FB_HOST_CONCURRENCY=4

# Character budget applied by the result shaper before a tool result is
# truncated; integer in [500, 10000000].
# (default: 25000)
#FB_MAX_RESULT_CHARS=25000

# ---------------------------------------------------------------------------
# Write safety
# ---------------------------------------------------------------------------

# Write gating mode: plan (validating dry-run preview, the default) or apply.
# It never covers the irreversible and spend tiers, which always need a
# per-call apply plus a plan_id.
# (default: plan; one of: plan | apply)
#FB_WRITE_MODE=plan

# Operator confirmation token for out-of-band approval of irreversible or
# spend actions. The server prompts through MCP elicitation where the client
# supports it; otherwise the caller passes this value as the confirm_token
# tool argument.
# (secret — never logged or returned by a tool)
#FB_CONFIRM_TOKEN=

# Directory permitted for local media uploads. Unset means URL-only uploads
# and no local file access at all.
#FB_MEDIA_DIR=

# Path to the append-only write journal. Defaults to the XDG/%APPDATA% state
# path; the file is created owner-only (0600) and rotates by size.
# (default: XDG / %APPDATA% state path)
#FB_JOURNAL_PATH=

# ---------------------------------------------------------------------------
# Tool surface
# ---------------------------------------------------------------------------

# Comma-separated tool packages or profiles to expose (e.g. core,posts,reader,
# or the profiles core|all|reader|publisher|moderator|ads). Omit for the
# default profile, which excludes ads.
# (default: core profile (all packages except `ads`))
#FB_TOOL_PACKAGES=

# Comma-separated packages to exclude even when FB_TOOL_PACKAGES enables them.
# Deny wins over allow.
#FB_PACKAGES_DENY=

# Comma-separated packages whose write tools are not registered at all; the
# read tools of those packages stay available.
#FB_PACKAGES_READONLY=

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

# Transport protocol: stdio (default) or http. The http transport binds
# 127.0.0.1 only and fails closed without FB_HTTP_TOKEN.
# (default: stdio; one of: stdio | http)
#FB_TRANSPORT=stdio

# Bearer token guarding the HTTP transport; required when FB_TRANSPORT=http
# (the server refuses to start without it).
# (required when FB_TRANSPORT=http; secret — never logged or returned by a tool)
#FB_HTTP_TOKEN=

# Port for the HTTP transport (loopback only); used when FB_TRANSPORT=http.
# Integer in [1, 65535].
# (default: 3000)
#FB_HTTP_PORT=3000

# ---------------------------------------------------------------------------
# Ads (opt-in package, off by default)
# ---------------------------------------------------------------------------

# Default ad account ID (act_… or the bare numeric id) for the opt-in ads
# package.
#FB_AD_ACCOUNT_ID=

# Hard ceiling for any ads budget write, in minor currency units (e.g. cents).
# Non-negative integer; a write above it is refused.
#FB_ADS_BUDGET_CEILING=

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

# Stderr log verbosity: debug, info, warn or error. Logs never go to stdout —
# that is the stdio protocol channel.
# (default: info; one of: debug | info | warn | error)
#FB_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Setup only — read by the `setup-token` subcommand, not by the server
# ---------------------------------------------------------------------------

# Short-lived user access token read by the setup-token subcommand when
# exchanging it for a long-lived Page token. Prefer this over passing the
# token as a command-line argument, where ps and the shell history can see it.
# The running server never reads this variable.
# (secret — never logged or returned by a tool)
#FB_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Named profiles (dynamic — one pair per Page you address by name)
# ---------------------------------------------------------------------------

# Page ID for a named profile, e.g. FB_PROFILE_BRAND_A_PAGE_ID. The profile
# key is the lower-cased <NAME>; pass it as the `profile` argument of a
# Page-scoped tool.
#FB_PROFILE_<NAME>_PAGE_ID=

# Optional per-profile token override for the matching
# FB_PROFILE_<NAME>_PAGE_ID.
# (secret — never logged or returned by a tool)
#FB_PROFILE_<NAME>_TOKEN=
